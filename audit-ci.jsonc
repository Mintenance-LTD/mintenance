{
  // Production-dependency vulnerability gate (2026-07-06 audit #1).
  // Blocks a PR when a NEW high or critical advisory appears in the
  // production dependency tree. `skip-dev` excludes build/test tooling
  // (vitest, vite, metro, detox, remotion studio) whose advisories never
  // reach the deployed runtime.
  //
  // The allowlist below pins the high+critical advisories that already
  // existed on 2026-07-06 — all transitive via tooling with no clean
  // upstream fix yet (grpc-js, minimatch, form-data, undici, ws,
  // shell-quote). A follow-up `npm audit fix` pass should shrink this list;
  // do NOT add to it without recording why the advisory is accepted.
  "high": true,
  "critical": true,
  "skip-dev": true,
  "report-type": "important",
  "allowlist": [
    "GHSA-5375-pq7m-f5r2",
    "GHSA-99f4-grh7-6pcq",
    "GHSA-hmw2-7cc7-3qxx",
    "GHSA-3ppc-4f35-3m26",
    "GHSA-7r86-cg39-jmmj",
    "GHSA-23c5-xmqv-rm74",
    "GHSA-w7jw-789q-3m8p",
    "GHSA-vxpw-j846-p89q",
    "GHSA-96hv-2xvq-fx4p",
    // --- Baseline refresh 2026-07-27 (CI-green session) -----------------
    // These 17 accumulated while the whole pipeline was red behind the
    // deep-link webpack failure (2026-07-21 → 2026-07-27), so this gate
    // never surfaced them on a PR. All are transitive or need a
    // major/framework bump; a dedicated dependency-remediation pass is
    // queued to shrink this list (see the spawned follow-up task). Fix
    // paths per npm audit are noted inline — remove each entry when its
    // bump lands.
    "GHSA-23hp-3jrh-7fpw", // tar (critical, DoS) — in-range fix; part of remediation pass
    "GHSA-8x88-c5mf-7j5w", // tar (high, infinite loop) — in-range fix
    "GHSA-395f-4hp3-45gv", // shell-quote (DoS) — in-range fix
    "GHSA-6gpp-xcg3-4w24", // next: middleware bypass — fixed by next minor bump (PRIORITY)
    "GHSA-89xv-2m56-2m9x", // next: SSRF in Server Actions (custom servers) — next minor bump (PRIORITY)
    "GHSA-m99w-x7hq-7vfj", // next: DoS in Server Actions — next minor bump (PRIORITY)
    "GHSA-p9j2-gv94-2wf4", // next: SSRF in rewrites — next minor bump (PRIORITY)
    "GHSA-gcfj-64vw-6mp9", // axios proxy inheritance — in-range fix
    "GHSA-4c8g-83qw-93j6", // fast-uri host confusion — in-range fix
    "GHSA-v2hh-gcrm-f6hx", // fast-uri host confusion — in-range fix
    "GHSA-52cp-r559-cp3m", // js-yaml quadratic CPU — in-range fix
    "GHSA-f88m-g3jw-g9cj", // sharp/libvips CVEs — needs sharp 0.35 (npm-major) bump
    "GHSA-6g55-p6wh-862q", // postcss source-map file read — blocked on expo 57 (SDK-54 pinned)
    "GHSA-r28c-9q8g-f849", // postcss path traversal — blocked on expo 57 (SDK-54 pinned)
    "GHSA-3jxr-9vmj-r5cp", // brace-expansion DoS — blocked on expo 57 (SDK-54 pinned)
