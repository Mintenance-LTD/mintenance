{
  // Production-dependency vulnerability gate (2026-07-06 audit #1).
  // Blocks a PR when a NEW high or critical advisory appears in the
  // production dependency tree. `skip-dev` excludes build/test tooling
  // (vitest, vite, metro, detox, remotion studio) whose advisories never
  // reach the deployed runtime.
  //
  // 2026-07-27 remediation pass: the 17 advisories the CI-green session
  // baselined were fixed (next 16.2.12, sharp 0.35.3 incl. next's nested
  // copy via override, tar/shell-quote/axios/fast-uri/js-yaml in-range,
  // adm-zip 0.6.0 via override) — see that commit for details. The
  // shell-quote critical GHSA-w7jw-789q-3m8p from the original 2026-07-06
  // baseline cleared in the same pass (shell-quote 1.10.0).
  //
  // 2026-09-30: patched Next, sharp, fast-uri, adm-zip, xmldom,
  // undici 6.x and each compatible brace-expansion major. Removed the
  // resolved undici/brace-expansion exceptions; no new exceptions added.
  // Remaining entries are the existing accepted baseline, not evidence
  // that these dependencies are vulnerability-free. Reassess each on upgrade.
  "high": true,
  "critical": true,
  "skip-dev": true,
  "report-type": "important",
  "allowlist": [
    // --- 2026-07-06 baseline (transitive, no clean upstream fix) --------
    "GHSA-5375-pq7m-f5r2", // @grpc/grpc-js
    "GHSA-99f4-grh7-6pcq", // @grpc/grpc-js
    "GHSA-hmw2-7cc7-3qxx", // form-data
    "GHSA-3ppc-4f35-3m26", // minimatch (nested <3.1.3 copies)
    "GHSA-7r86-cg39-jmmj", // minimatch
    "GHSA-23c5-xmqv-rm74", // minimatch
    "GHSA-96hv-2xvq-fx4p", // ws
    // --- Blocked on expo 57 / upstream pins (2026-07-27) ----------------
    "GHSA-6g55-p6wh-862q", // postcss ≤8.5.11 — nested under next (8.4.31) + @expo/metro-config (8.4.49); root copy is patched
    "GHSA-r28c-9q8g-f849", // postcss ≤8.5.17 — same nested copies
    // --- 2026-08-05 (main-red CI unblock) -------------------------------
    // --- 2026-09-05: Metro's image parser (no patched npm release) -------
    // image-size is reachable only through mobile -> Expo -> Metro and is
    // used by Metro while bundling image assets. The current npm release
    // (2.0.2) remains affected by both parser DoS advisories and the
    // registry lists no patched version. The web/server source tree has no
    // image-size import. Keep these explicit until Expo/Metro moves to a
    // patched parser; do not treat this as a runtime vulnerability fix.
    "GHSA-5p2g-fcmc-qvqq",
    "GHSA-w3rx-r6r6-pgpr"
  ]
}
